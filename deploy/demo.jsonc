{
  // Showcase deployment: the IIIF Auth 2.0 demo site (https://iiif-auth-demo.ldas.jp)
  // and the Kasane samples (https://kasane.ldas.jp). iiif-demo-models.ldas.jp is the
  // old host name, kept while hongo-campus-iiif's ueno.json still points to it.
  // Collections here use "clickthrough": no login, the user only agrees to a notice
  // (a content advisory, like Wellcome Collection's). The files are not secret.
  // Build the files with scripts/build-demo-assets.zsh, deploy with scripts/deploy.zsh.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iiif-demo-models",
  "main": "../src/index.ts",
  "compatibility_date": "2026-08-20",
  "account_id": "7efcf816ee8a11cebbfcc7115bbca3d5",

  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "iiif-auth-demo.ldas.jp", "custom_domain": true },
    { "pattern": "iiif-demo-models.ldas.jp", "custom_domain": true }
  ],

  "assets": {
    "directory": "../assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "vars": {
    // Not used by clickthrough collections.
    "ACCESS_TEAM_DOMAIN": "https://nakamura196.cloudflareaccess.com",
    "DEMOS": [
      {
        "type": "clickthrough",
        "collection": "terms",
        "image": "hyakki",
        "title": { "en": ["Agree to the terms"], "ja": ["利用条件に同意する"] },
        "description": {
          "en": ["No login. The viewer shows a notice; agreeing opens the image (an active access service with a confirm button)."],
          "ja": ["ログインはありません。ビューアに案内が出て、同意すると画像が見えます（active の access service に確認ボタンだけを付けた型）。"]
        }
      },
      {
        "type": "degraded",
        "collection": "degraded",
        "image": "hyakki17",
        "title": { "en": ["See a small greyscale copy first"], "ja": ["まず小さな白黒の版を見せる"] },
        "description": {
          "en": ["Before agreeing, the viewer shows a small greyscale copy (the probe answers 401 with a substitute). Agreeing replaces it with the full colour image. Clients that do not read substitute show nothing until you agree."],
          "ja": ["同意する前は、小さな白黒の版が見えます（probe が 401 と substitute を返す型）。同意すると、カラーの高精細版に替わります。substitute を読まないビューアでは、同意するまで何も出ません。"]
        }
      }
    ],
    "COLLECTIONS": {
      "terms": {
        "mode": "clickthrough",
        "allowedOrigins": ["https://kasane.ldas.jp", "https://tomcrane.github.io", "http://localhost:3838"],
        "label": { "en": ["Agree to the terms of use"], "ja": ["利用条件に同意する"] },
        "heading": { "en": ["Terms of use"], "ja": ["利用条件の確認"] },
        "note": {
          "en": ["This image is in the public domain. The agreement is here only to show how the IIIF Authorization Flow works. Please credit the National Diet Library Digital Collections when you use it."],
          "ja": ["この画像はパブリックドメインです。この確認は、IIIF の認証の動きをお見せするためだけに入れています。使うときは、出典（国立国会図書館デジタルコレクション）を示してください。"]
        },
        "confirmLabel": { "en": ["Agree and view"], "ja": ["同意して表示"] },
        "logoutLabel": { "en": ["Withdraw agreement"], "ja": ["同意を取り消す"] },
        "cookieMaxAge": 3600
      },
      "degraded": {
        "mode": "clickthrough",
        "allowedOrigins": ["https://kasane.ldas.jp", "https://tomcrane.github.io", "http://localhost:3838"],
        "label": { "en": ["Agree to the terms of use"], "ja": ["利用条件に同意する"] },
        "heading": { "en": ["Full image after agreeing"], "ja": ["同意すると高精細で見られます"] },
        "note": {
          "en": ["You are looking at a small greyscale copy. Agree to the terms of use to see the full colour image. The image is in the public domain; the agreement is here only to show how the IIIF Authorization Flow works. Please credit the National Diet Library Digital Collections when you use it."],
          "ja": ["いま見えているのは、小さな白黒の版です。利用条件に同意すると、カラーの高精細版が見られます。この画像はパブリックドメインです。この確認は、IIIF の認証の動きをお見せするためだけに入れています。使うときは、出典（国立国会図書館デジタルコレクション）を示してください。"]
        },
        "confirmLabel": { "en": ["Agree and view"], "ja": ["同意して表示"] },
        "logoutLabel": { "en": ["Withdraw agreement"], "ja": ["同意を取り消す"] },
        "substituteLabel": { "en": ["Small greyscale copy"], "ja": ["小さな白黒の版"] },
        "cookieMaxAge": 3600
      },
      "ueno": {
        "mode": "clickthrough",
        "allowedOrigins": ["https://kasane.ldas.jp", "http://localhost:3838"],
        "label": { "en": ["View the Ueno 3D models"], "ja": ["上野の 3D モデルを見る"] },
        "heading": { "en": ["Before you view"], "ja": ["ご覧になる前に"] },
        "note": {
          "en": ["These 3D models of Ueno are a sample built from PLATEAU building data and point clouds. Shapes and heights may differ from the real buildings. This notice is here to show how the IIIF Authorization Flow works."],
          "ja": ["この上野の 3D モデルは、PLATEAU の建物データと点群から作った見本です。建物の形や高さは、実際と異なる場合があります。この確認は、IIIF の認証（同意画面）の動きをお見せするために入れています。"]
        },
        "confirmLabel": { "en": ["Agree and view"], "ja": ["同意して表示"] },
        "logoutLabel": { "en": ["Withdraw agreement"], "ja": ["同意を取り消す"] },
        "cookieMaxAge": 86400
      }
    }
  }
}
